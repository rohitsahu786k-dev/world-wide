# Copy to .env.local and fill in real values. Never commit .env.local.

# --- WordPress backend -----------------------------------------------------
# Origin only, no trailing slash and no /wp-json suffix.
NEXT_PUBLIC_WP_BASE_URL=https://your-wp-host.example.com
# Basic auth header for a WP Application Password, including the "Basic " prefix:
#   printf 'user@example.com:xxxx xxxx xxxx xxxx xxxx xxxx' | base64
# Server-side only — never expose this to the browser.
WP_BASIC_AUTH=Basic <base64-of-user:application-password>

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.worldwidesupply28.com

# --- Optional services (features degrade gracefully if unset) --------------
DATABASE_URL=
RESEND_API_KEY=
ADMIN_EMAIL=
